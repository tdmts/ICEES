.claude/settings.local.json

# Ruwe Brightspace-topics, klaargezet door `orion.py import-brightspace` en per
# pagina omgezet met orion-convert. Wordt nooit gepubliceerd; de omgezette
# pagina onder Labo/<Naam>/ wel.
_incoming/

# PDF-exports van `orion.py export-pdf`. Afgeleid materiaal: de pagina onder
# Labo/<Naam>/ is het origineel, de PDF maak je opnieuw wanneer je er een
# nodig hebt.
_export/

# De oplossingen van de labo-opdrachten, en de antwoordbestanden waaruit
# `orion.py export-oplossing` ze maakt. Alles onder tdmts.github.io is publiek,
# dus een oplossing die hier in git belandt, staat op het net. De lector laadt
# ze met de hand op naar Orion. Het script zelf draagt geen antwoorden en zit
# in OrionTools.
_oplossingen/
